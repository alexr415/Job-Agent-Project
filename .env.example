# Copy to .env.local and fill in. .env.local is gitignored; this file is not.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=
# The server-only "secret" key (older projects call it "service_role").
# Never expose it to the browser: no NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Any long random string. Add the same value in Vercel; Vercel Cron sends it to /api/cron/*.
CRON_SECRET=
